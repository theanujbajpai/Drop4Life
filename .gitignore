# =========================
# Drop4Life .gitignore
# =========================

# --- Backend (Spring Boot / Maven) ---
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
backend/*.jar
backend/*.war
backend/*.class
backend/logs/
backend/*.log

# --- Frontend (Angular / Node) ---
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/.sass-cache/
frontend/coverage/
frontend/tmp/
frontend/out-tsc/

# --- IDE ---
.idea/
*.iml
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Environment / Secrets ---
.env
.env.local
.env.*.local
backend/src/main/resources/application-local.yml

# --- Docker ---
docker-compose.override.yml

# --- Misc ---
*.bak
*.tmp
*.orig
